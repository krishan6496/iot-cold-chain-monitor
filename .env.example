PORT=3000
API_KEY=mysecret            # same value goes in firmware API_KEY
ADMIN_KEY=                  # set to enable DELETE /api/readings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RETENTION_DAYS=0            # auto-delete readings older than N days (0 = keep all)
OFFLINE_AFTER_SEC=60        # device counts as offline after this long without data
